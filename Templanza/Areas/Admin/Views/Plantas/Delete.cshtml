@model Planta
@{
    ViewData["Title"] = "Eliminar planta";
}

<h1>Eliminar planta</h1>

<div class="alert alert-warning">¿Confirmás que querés eliminar esta planta?</div>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.NombreComun)</dt>
    <dd class="col-sm-9">@Model.NombreComun</dd>

    <dt class="col-sm-3">Categoría</dt>
    <dd class="col-sm-9">@Model.Categoria?.Nombre</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Precio)</dt>
    <dd class="col-sm-9">@Model.Precio.ToString("C")</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
