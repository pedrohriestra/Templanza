@model CorreoEnviado
@{
    ViewData["Title"] = "Eliminar registro de correo";
}

<h1>Eliminar registro de correo</h1>

<div class="alert alert-warning">¿Confirmás que querés eliminar este registro del log?</div>

<dl class="row">
    <dt class="col-sm-2">Destinatario</dt>
    <dd class="col-sm-10">@Model.Destinatario</dd>

    <dt class="col-sm-2">Asunto</dt>
    <dd class="col-sm-10">@Model.Asunto</dd>
</dl>

<form asp-action="Delete" data-confirm="¿Eliminar este registro del log de correos?">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
