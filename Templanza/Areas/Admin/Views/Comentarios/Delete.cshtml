@model Comentario
@{
    ViewData["Title"] = "Eliminar comentario";
}

<h1>Eliminar comentario</h1>

<div class="alert alert-warning">¿Confirmás que querés eliminar este comentario?</div>

<dl class="row">
    <dt class="col-sm-2">Blend</dt>
    <dd class="col-sm-10">@Model.Blend?.Nombre</dd>

    <dt class="col-sm-2">Autor</dt>
    <dd class="col-sm-10">@Model.Usuario?.Nombre</dd>

    <dt class="col-sm-2">Texto</dt>
    <dd class="col-sm-10">@Model.Texto</dd>
</dl>

<form asp-action="Delete" data-confirm="¿Eliminar este comentario de forma permanente?">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
