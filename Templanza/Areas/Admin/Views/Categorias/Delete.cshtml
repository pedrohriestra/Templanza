@model Categoria
@{
    ViewData["Title"] = "Eliminar categoría";
}

<h1>Eliminar categoría</h1>

<div class="alert alert-warning">¿Confirmás que querés eliminar esta categoría?</div>

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Nombre)</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Descripcion)</dt>
    <dd class="col-sm-10">@Model.Descripcion</dd>
</dl>

<form asp-action="Delete" data-confirm="¿Eliminar la categoría '@Model.Nombre'? Esta acción no se puede deshacer.">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
