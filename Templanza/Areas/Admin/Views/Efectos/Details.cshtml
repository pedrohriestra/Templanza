@model Efecto
@{
    ViewData["Title"] = "Detalle de efecto";
}

<h1>Detalle de efecto</h1>

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Nombre)</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Descripcion)</dt>
    <dd class="col-sm-10">@Model.Descripcion</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>
