@model BlendViewModel

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="CategoriaId" class="form-label"></label>
    <select asp-for="CategoriaId" asp-items="Model.Categorias" class="form-select">
        <option value="">-- Seleccione --</option>
    </select>
    <span asp-validation-for="CategoriaId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Descripcion" class="form-label"></label>
    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Descripcion" class="text-danger"></span>
</div>

<div class="mb-3">
    <label class="form-label">Plantas de la receta</label>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th></th>
                    <th>Planta</th>
                    <th style="width: 150px">Cantidad</th>
                    <th style="width: 150px">Unidad</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Plantas.Count; i++)
                {
                    <tr>
                        <td>
                            <input type="hidden" asp-for="Plantas[i].PlantaId" />
                            <input type="hidden" asp-for="Plantas[i].NombrePlanta" />
                            <input type="checkbox" asp-for="Plantas[i].Seleccionado" class="form-check-input" />
                        </td>
                        <td>@Model.Plantas[i].NombrePlanta</td>
                        <td>
                            <input asp-for="Plantas[i].Cantidad" type="number" step="0.01" class="form-control form-control-sm" />
                        </td>
                        <td>
                            <input asp-for="Plantas[i].Unidad" placeholder="g, cucharadas..." class="form-control form-control-sm" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
