@model Blend
@{
    ViewData["Title"] = "Eliminar blend recomendado";
}

<h1>Eliminar blend recomendado</h1>

<div class="alert alert-warning">¿Confirmás que querés eliminar este blend recomendado?</div>

<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>

    <dt class="col-sm-2">Categoría</dt>
    <dd class="col-sm-10">@Model.Categoria?.Nombre</dd>
</dl>

<form asp-action="DeleteRecomendado">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
