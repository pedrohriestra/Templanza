@model Blend
@{
    ViewData["Title"] = "Rechazar blend";
}

<h1>Rechazar blend</h1>

<div class="alert alert-warning">¿Confirmás que querés rechazar y eliminar este blend del foro?</div>

<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>

    <dt class="col-sm-2">Autor</dt>
    <dd class="col-sm-10">@Model.Usuario?.Nombre</dd>

    <dt class="col-sm-2">Descripción</dt>
    <dd class="col-sm-10">@Model.Descripcion</dd>
</dl>

<form asp-action="Rechazar">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Rechazar y eliminar</button>
    <a asp-action="Pendientes" class="btn btn-secondary">Cancelar</a>
</form>
