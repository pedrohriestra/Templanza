@model ApplicationUser
@{
    ViewData["Title"] = "Detalle de usuario";
    IList<string> roles = ViewBag.Roles;
}

<h1>Detalle de usuario</h1>

<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>

    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>

    <dt class="col-sm-2">Rol</dt>
    <dd class="col-sm-10">@string.Join(", ", roles)</dd>

    <dt class="col-sm-2">Email confirmado</dt>
    <dd class="col-sm-10">@(Model.EmailConfirmed ? "Sí" : "No")</dd>

    <dt class="col-sm-2">Teléfono</dt>
    <dd class="col-sm-10">@Model.PhoneNumber</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>
