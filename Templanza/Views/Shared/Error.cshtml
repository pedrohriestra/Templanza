@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">Ocurrió un error al procesar tu solicitud.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Modo desarrollo</h3>
<p>
    Cambiar al entorno <strong>Development</strong> muestra información más detallada sobre el error ocurrido.
</p>
<p>
    <strong>El entorno Development no debería estar habilitado en aplicaciones desplegadas en producción.</strong>
    Puede exponer información sensible de las excepciones a los usuarios finales.
    Para debug local, habilitá el entorno <strong>Development</strong> configurando la variable de entorno <strong>ASPNETCORE_ENVIRONMENT</strong> en <strong>Development</strong>
    y reiniciando la app.
</p>
