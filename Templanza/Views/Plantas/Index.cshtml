@model IEnumerable<Planta>
@{
    ViewData["Title"] = "Tienda";
    List<Categoria> categorias = ViewBag.Categorias;
    int? categoriaSeleccionada = ViewBag.CategoriaSeleccionada;
}

@functions {
    string IconoCategoria(int categoriaId) => categoriaId switch
    {
        1 => "🍵",
        2 => "🌼",
        3 => "⚡",
        4 => "💧",
        5 => "🌸",
        6 => "🛡️",
        _ => "🌿"
    };
}

<div class="text-center mb-4">
    <h1>Tienda</h1>
    <p class="text-muted">Hierbas y tés listos para comprar.</p>
</div>

<div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-sm rounded-pill px-3 @(categoriaSeleccionada is null ? "btn-primary" : "btn-outline-primary")">Todas</a>
    @foreach (var categoria in categorias)
    {
        <a asp-action="Index" asp-route-categoriaId="@categoria.Id" class="btn btn-sm rounded-pill px-3 @(categoriaSeleccionada == categoria.Id ? "btn-primary" : "btn-outline-primary")">@IconoCategoria(categoria.Id) @categoria.Nombre</a>
    }
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
    @foreach (var planta in Model)
    {
        <div class="col">
            <div class="card h-100">
                <div class="planta-thumb">
                    @if (!string.IsNullOrEmpty(planta.ImagenUrl))
                    {
                        <img src="@planta.ImagenUrl" alt="@planta.NombreComun" loading="lazy" />
                    }
                    else
                    {
                        @IconoCategoria(planta.CategoriaId)
                    }
                </div>
                <div class="card-body">
                    <span class="badge-categoria">@planta.Categoria?.Nombre</span>
                    <h5 class="card-title mt-2 mb-0">@planta.NombreComun</h5>
                    <p class="text-muted small fst-italic mb-2">@planta.NombreCientifico</p>
                    <p class="card-text fs-5 fw-bold mb-2">@planta.Precio.ToString("C")</p>
                    @if (planta.Stock > 0)
                    {
                        <span class="badge badge-stock-disponible mb-3">Stock: @planta.Stock</span>
                    }
                    else
                    {
                        <span class="badge badge-stock-agotado mb-3">Sin stock</span>
                    }
                    <a asp-action="Details" asp-route-id="@planta.Id" class="btn btn-outline-primary w-100">Ver más</a>
                </div>
            </div>
        </div>
    }
</div>
