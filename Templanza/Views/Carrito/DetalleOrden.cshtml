@model Orden
@{
    ViewData["Title"] = $"Orden #{Model.Id}";
}

<h1>Orden #@Model.Id</h1>
<h6 class="text-muted">@Model.FechaCreacion.ToString("g") · Estado: @Model.Estado</h6>

<table class="table">
    <thead>
        <tr>
            <th>Planta</th>
            <th>Cantidad</th>
            <th>Precio unitario</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ItemOrdenes)
        {
            <tr>
                <td>@item.Planta?.NombreComun</td>
                <td>@item.Cantidad</td>
                <td>@item.PrecioUnitario.ToString("C")</td>
                <td>@((item.Cantidad * item.PrecioUnitario).ToString("C"))</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Total</th>
            <th>@Model.Total.ToString("C")</th>
        </tr>
    </tfoot>
</table>

<a asp-action="MisOrdenes" class="btn btn-secondary">Volver a mis compras</a>
