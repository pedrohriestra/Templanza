@model CarritoViewModel
@{
    ViewData["Title"] = "Carrito";
}

<h1>Tu carrito</h1>

@if (!Model.Items.Any())
{
    <p>Tu carrito está vacío.</p>
    <a asp-controller="Plantas" asp-action="Index" class="btn btn-primary">Ir a la tienda</a>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Planta</th>
                <th>Precio unitario</th>
                <th style="width: 150px">Cantidad</th>
                <th>Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.NombreComun</td>
                    <td>@item.Precio.ToString("C")</td>
                    <td>
                        <form asp-action="ActualizarCantidad" method="post" class="d-flex gap-2 align-items-center">
                            <input type="hidden" name="plantaId" value="@item.PlantaId" />
                            <div class="stepper-cantidad">
                                <button type="button" data-step="-1">−</button>
                                <input type="number" name="cantidad" value="@item.Cantidad" min="1" max="@item.StockDisponible" class="stepper-cantidad-input" />
                                <button type="button" data-step="1">+</button>
                            </div>
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Actualizar</button>
                        </form>
                    </td>
                    <td>@item.Subtotal.ToString("C")</td>
                    <td>
                        <form asp-action="Eliminar" method="post" data-confirm="¿Quitar '@item.NombreComun' del carrito?">
                            <input type="hidden" name="plantaId" value="@item.PlantaId" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">Quitar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Total</th>
                <th>@Model.Total.ToString("C")</th>
                <th></th>
            </tr>
        </tfoot>
    </table>

    <form asp-action="Confirmar" method="post">
        <button type="submit" class="btn btn-success">Confirmar compra</button>
    </form>
}
