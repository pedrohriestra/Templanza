@model IEnumerable<Blend>
@{
    ViewData["Title"] = "Foro de Blends";
}

<div class="d-flex justify-content-between align-items-center">
    <h1>Foro de Blends</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-primary">Crear blend</a>
    }
</div>
<p class="text-muted">Combinaciones de hierbas armadas por la comunidad, aprobadas por moderación.</p>

@if (!Model.Any())
{
    <p>Todavía no hay blends publicados.</p>
}

<div class="row row-cols-1 row-cols-md-2 g-3">
    @foreach (var blend in Model)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@blend.Nombre</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@blend.Categoria?.Nombre · por @blend.Usuario?.Nombre</h6>
                    <p class="card-text">@blend.Descripcion</p>
                    <p class="text-muted mb-2">
                        <i class="bi"></i>❤ @blend.BlendLikes.Count &nbsp;·&nbsp; 💬 @blend.Comentarios.Count
                    </p>
                    <a asp-action="Details" asp-route-id="@blend.Id" class="btn btn-outline-primary">Ver blend</a>
                </div>
            </div>
        </div>
    }
</div>
