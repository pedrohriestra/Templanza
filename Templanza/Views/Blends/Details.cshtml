@model Blend
@{
    ViewData["Title"] = Model.Nombre;
    bool yaLeDioLike = ViewBag.YaLeDioLike;
}

<h1>@Model.Nombre</h1>
<h6 class="text-muted">@Model.Categoria?.Nombre · por @Model.Usuario?.Nombre</h6>

@if (!Model.EsPublicado)
{
    <div class="alert alert-warning">Este blend todavía no fue aprobado por un moderador.</div>
}

<p>@Model.Descripcion</p>

<h5>Ingredientes</h5>
<ul>
    @foreach (var bp in Model.BlendPlantas)
    {
        <li>@bp.Planta?.NombreComun — @bp.Cantidad @bp.Unidad</li>
    }
</ul>

@if (!Model.EsRecomendado)
{
    <div class="my-3">
        @if (User.Identity?.IsAuthenticated == true && Model.EsPublicado)
        {
            <form asp-action="Like" method="post" class="d-inline">
                <input type="hidden" name="blendId" value="@Model.Id" />
                <button type="submit" class="btn @(yaLeDioLike ? "btn-danger" : "btn-outline-danger")">
                    ❤ @(yaLeDioLike ? "Quitar like" : "Me gusta") (@Model.BlendLikes.Count)
                </button>
            </form>
        }
        else
        {
            <span>❤ @Model.BlendLikes.Count</span>
        }
    </div>

    <h5>Comentarios (@Model.Comentarios.Count)</h5>
    @if (User.Identity?.IsAuthenticated == true && Model.EsPublicado)
    {
        <form asp-action="Comentar" method="post" class="mb-3">
            <input type="hidden" name="blendId" value="@Model.Id" />
            <div class="mb-2">
                <textarea name="texto" class="form-control" rows="2" placeholder="Dejá tu comentario..." required></textarea>
            </div>
            <button type="submit" class="btn btn-outline-primary btn-sm">Comentar</button>
        </form>
    }

    <ul class="list-group">
        @foreach (var comentario in Model.Comentarios.OrderByDescending(c => c.FechaCreacion))
        {
            <li class="list-group-item">
                <strong>@comentario.Usuario?.Nombre</strong>
                <small class="text-muted">@comentario.FechaCreacion.ToString("g")</small>
                <p class="mb-0">@comentario.Texto</p>
            </li>
        }
    </ul>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Volver al foro</a>
</div>
